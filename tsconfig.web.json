{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  // core/names.ts is plain wording shared with the main process; nothing else in core is meant for the page.
  "include": ["src/renderer/src/**/*", "src/core/names.ts"]
}
